{
  "name": "auto-deploy",
  "version": "0.1.0",
  "description": "A CLI tool for auto deployment",
  "type": "module",
  "bin": {
    "auto-deploy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "npm run build && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "deploy"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  }
}
